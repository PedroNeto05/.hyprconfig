# ~/.config/dunst/dunstrc

[global]
    ### Display ###
    
    # Define a largura, altura e posição da notificação no seu monitor
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (20, 20)

    # Adiciona um pequeno espaço entre múltiplas notificações
    notification_limit = 5
    separator_height = 2
    
    ### Estilo Base (Sincronizado com o Rofi) ###
    
    # Cores base do Tokyo Night
    separator_color = "#414868"
    
    # Espaçamento interno (semelhante ao padding do rofi)
    padding = 15
    horizontal_padding = 15
    
    # Bordas e arredondamento exatos do seu rofi (2px)
    frame_width = 2
    frame_color = "#414868"
    corner_radius = 2

    ### Texto ###
    
    # Substitua "Sans" pela mesma fonte que você usa no seu "shared/fonts.rasi"
    font = Sans 11
    
    # Formato do texto: Título em negrito (como no Rofi) e corpo normal
    format = "<b>%s</b>\n%b"
    
    # Alinhamento
    alignment = left
    vertical_alignment = center
    
    # Quebra de linha e comportamento
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    
    ### Ícones ###
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64

[urgency_low]
    # Notificações de baixa prioridade
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#414868"
    timeout = 3

[urgency_normal]
    # Notificações normais (Usando o background-alt para dar um leve destaque)
    background = "#24283b"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7" # Usando o 'blue' do seu tema como borda de destaque
    timeout = 5

[urgency_critical]
    # Notificações críticas (Avisos de bateria, erros, etc)
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e" # A cor 'urgent' vermelha/rosa do Tokyo Night
    timeout = 0 # 0 significa que ela não vai sumir até você clicar
