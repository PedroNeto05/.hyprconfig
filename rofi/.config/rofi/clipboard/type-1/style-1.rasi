/**
 * Rofi Theme File - Clipboard Version
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "clipboard";
    show-icons:                 true;
    display-clipboard:          "";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

* {
    background-color:            transparent;
    text-color:                  @foreground;
    spacing:                     0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       40%; /* Aumentado de 20% para 40% para clipboard */

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               2px;
    border-color:                @border-subtle;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    background-color:            @background;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    background-color:            @entry-bg;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search Clipboard...";
    placeholder-color:           @placeholder;
    
    text-transform:              bold;
    border-radius:               2px;
    padding:                     12px;
    margin:                      10px;
    vertical-align:              0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    
    padding:                     10px;
    background-color:            @background;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px; /* Mais espaço entre ícone e texto */
    border-radius:               2px;
    background-color:            transparent;
    cursor:                      pointer;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @active; 
    border:                      2px solid;
    border-color:                @border-subtle;
}

element-icon {
    size:                        64px; /* Aumentado de 24px para 64px para ver a imagem */
    cursor:                      inherit;
    vertical-align:              0.5;
    margin:                      5px 0 5px 10px;
}

element-text {
    text-color:                  inherit;
    highlight:                   @blue;
    cursor:                      inherit;
    vertical-align:              0.5;
    
    text-transform:              bold;
    padding:                     5px;
    margin:                      5px 10px 5px 0;
}

/*****----- Message -----*****/
error-message {
    padding:                     15px;
    border:                      2px solid;
    border-radius:               2px;
    border-color:                @border-subtle;
    background-color:            @background;
    text-color:                  @foreground;
}
