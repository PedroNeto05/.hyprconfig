/**
 * Rofi Theme File - Wi-Fi Menu
 **/

/*****----- Configuration -----*****/
configuration {
    show-icons:                  false; /* Usamos ícones de texto (Nerd Fonts) direto no script */
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

* {
    background-color:            transparent;
    text-color:                  @foreground;
    spacing:                     0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       25%; /* Aumentei levemente para acomodar nomes de redes mais longos */

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               2px;
    border-color:                @border-subtle;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    background-color:            @background;
    children:                    [ "prompt", "entry" ]; /* Prompt adicionado aqui */
    padding:                     10px;
}

/* Estilo do Título (Ex: 󰤨 Wi-Fi, Nome da Rede ou Senha) */
prompt {
    enabled:                     true;
    background-color:            @selected;
    text-color:                  @active; /* O verde do Tokyo Night */
    padding:                     12px 15px;
    border-radius:               2px;
    font:                        "bold";
}

entry {
    enabled:                     true;
    background-color:            @entry-bg;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Buscar rede...";
    placeholder-color:           @placeholder;
    
    text-transform:              bold;
    border-radius:               2px;
    padding:                     12px;
    margin:                      0px 0px 0px 10px; /* Espaçamento entre o prompt e a barra de digitação */
    vertical-align:              0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    
    padding:                     10px;
    background-color:            @background;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     0px;
    border-radius:               2px;
    background-color:            transparent;
    cursor:                      pointer;
    padding:                     0px;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @active;
    border:                      2px solid;
    border-color:                @border-subtle;
}

element-text {
    text-color:                  inherit;
    highlight:                   @blue;
    cursor:                      inherit;
    vertical-align:              0.5;
    
    text-transform:              bold;
    padding:                     10px 15px; /* Ajuste para o texto respirar melhor dentro do item */
    margin:                      0px;
}

/*****----- Message -----*****/
error-message {
    padding:                     15px;
    border:                      2px solid;
    border-radius:               2px;
    border-color:                @border-subtle;
    background-color:            @background;
    text-color:                  @foreground;
}
